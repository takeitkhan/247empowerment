function mm_spg_build_phase_3_steps($interest_slug)
{
    $paths = mm_spg_interest_paths();

    // No matching interest
    if (empty($interest_slug) || !isset($paths[$interest_slug])) {
        return [];
    }

    // Ensure all returned steps are Phase 3 (safety)
    foreach ($paths[$interest_slug] as &$step) {
        $step['phase'] = 3;
    }

    return $paths[$interest_slug];
}



