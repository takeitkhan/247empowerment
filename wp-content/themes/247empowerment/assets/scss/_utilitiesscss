@use "variables" as *;

.text-shadow-lg {
  text-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.5);
}


.container {
  max-width: 1440px !important;
  margin-right: 24px !important;
  margin-left: 24px !important;
  margin: 0 auto !important;
}


.container-home {
  max-width: 1200px !important;
}

.bg-custom-gray {
  background-color: #E7EEFB !important;
  border: 1px solid #B5C9F2 !important;
}

.custom-card {
  padding: 20px;
  border-radius: 8px;
  margin-bottom: 20px;

  h6 {
    margin-top: 15px !important;
  }
  p {
    line-height: 30px !important;
  }
}

.custom-padding-top {
  padding-top: 50px;
  padding-bottom: 50px;
}

.img44 {
  width: 44px !important;
  height: 44px !important;
}

.img80 {
  width: 80px !important;
  height: 80px !important;

  @media (max-width: 767.98px) {
    width: 60px !important;
    height: 60px !important;
  }

  .active-icon {
    top: 65px;
    right: 7px;
  }
}



.gap12 {
  gap: 12px;
}

.gap10 {
  gap: 10px;
}

.img271 {
  width: auto !important;
  height: 271px !important;

  img {
    border-radius: 8px;
  }
}

.img177 {
  width: 177px !important;
  height: 177px !important;
}

.img24 {
  width: 24px;
  height: 24px;
}

.img20 {
  width: 20px;
  height: 20px;
}

.img18 {
  width: 18px;
  height: 18px;
}

.img16 {
  width: 16px;
  height: 20px;
}

.img29 {
  width: 29.27px;
  height: 28.33px;
}

/* .img240 {
  min-width: 240px;
  height: 220px;

  img {
