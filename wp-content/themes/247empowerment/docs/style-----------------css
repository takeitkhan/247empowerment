/* Reactions and Comments Styling */
.reaction-btn {
  transition: all 0.3s ease;
  font-size: 13px !important;
}

.reaction-btn:hover {
  background-color: #e9f3fe !important;
  transform: scale(1.05);
}

.reaction-btn.active {
  background-color: #0c53ac !important;
  color: white !important;
  font-weight: 600;
}

.comment-item {
  padding: 0;
  margin-bottom: 12px;
  transition: margin-left 0.3s ease;
}

.comment-bubble {
  background-color: #f0f2f5 !important;
  border-radius: 18px !important;
  padding: 10px 14px !important;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.comment-bubble strong {
  font-size: 14px;
  font-weight: 600;
  color: #050505;
}

.reply-btn {
  font-weight: 600;
  color: #0c53ac !important;
  transition: color 0.2s ease;
}

.reply-btn:hover {
  color: #084080 !important;
  text-decoration: underline !important;
}

.reply-input-container {
  margin-top: 8px;
  padding-left: 8px;
}

.comment-reply-input {
  border: 1px solid #ddd !important;
  border-radius: 20px !important;
  padding: 6px 14px !important;
  font-size: 13px !important;
}

.comment-reply-input:focus {
  border: 2px solid #0c53ac !important;
  box-shadow: 0 0 0 0.2rem rgba(12, 83, 172, 0.15) !important;
}

.comment-section {
  max-height: 500px;
  overflow-y: auto;
  margin-bottom: 8px;
  padding: 8px 0;
}

.comment-section::-webkit-scrollbar {
  width: 6px;
}

.comment-section::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 10px;
}

.comment-section::-webkit-scrollbar-thumb {
  background: #888;
  border-radius: 10px;
}

.comment-section::-webkit-scrollbar-thumb:hover {
  background: #555;
}

.comment-input {
  border: 1px solid #ddd !important;
  border-radius: 20px !important;
  padding: 8px 16px !important;
  font-size: 14px !important;
}

.comment-input:focus {
  border: 2px solid #0c53ac !important;
  box-shadow: 0 0 0 0.2rem rgba(12, 83, 172, 0.25) !important;
}

.comment-btn {
  border-radius: 4px !important;
  padding: 6px 14px !important;
  font-size: 12px !important;
}

.post-actions {
  background-color: #fafafa;
  border-radius: 0 0 8px 8px;
}


/* Book Container Styling */
css.book-container .pages         { display: none !important; }
.book-container .pages.current { display: block !important; }