.leaderboard-card {
  padding: 20px;
}

.leaderboard-card__eyebrow {
  color: #a0abc7;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.leaderboard-card__badge {
  min-width: 52px;
  height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  background: rgba(5, 72, 156, 0.1);
  color: #05489c;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
}

.leaderboard-card__copy {
  margin: 16px 0 0;
  color: #6b7280;
  font-size: 13px;
  line-height: 1.5;
}

.leaderboard-card__summary {
  margin-top: 16px;
  padding: 14px 16px;
  border-radius: 16px;
  background: linear-gradient(135deg, #f3f8ff, #ffffff);
  border: 1px solid rgba(190, 201, 229, 0.6);
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 6px 12px;
}

.leaderboard-card__summary-label {
  display: block;
  color: #7b88a8;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.leaderboard-card__summary-rank {
  color: #1d2433;
  font-size: 24px;
  line-height: 1.1;
}

.leaderboard-card__summary-points {
  align-self: center;
  justify-self: end;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: #05489c;
  font-size: 12px;
  line-height: 1.1;
}

.leaderboard-card__summary-points strong {
  font-size: 18px;
}

.leaderboard-card__summary-progress {
  grid-column: 1 / -1;
  color: #5e6b85;
  font-size: 12px;
  font-weight: 600;
}

.leaderboard-list {
  margin-top: 16px;
}

.leaderboard-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid rgba(190, 201, 229, 0.45);
}

.leaderboard-item:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.leaderboard-item__rank {
  min-width: 40px;
  font-size: 13px;
  font-weight: 700;
  color: #05489c;
}

.leaderboard-item__avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #05489c, #5a8dde);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  flex-shrink: 0;
  overflow: hidden;
}

.leaderboard-item__avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.leaderboard-item__body {
  min-width: 0;
  flex: 1 1 auto;
}

.leaderboard-item__name {
  color: #2e2e2e;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.2;
}

.leaderboard-item__label {
  color: #8c96b0;
  font-size: 12px;
  margin-top: 4px;
  line-height: 1.3;
}

.leaderboard-item__points {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: #05489c;
  font-size: 12px;
  line-height: 1.1;
  flex-shrink: 0;
}

.leaderboard-item__points strong {
  font-size: 15px;
}

.leaderboard-item.is-featured .leaderboard-item__rank {
  color: #d69a00;
}

.leaderboard-card__empty {
  margin-top: 16px;
  padding: 14px 15px;
  border-radius: 14px;
  background: #f8fafc;
  color: #60708f;
  font-size: 13px;
  line-height: 1.5;
  border: 1px solid rgba(190, 201, 229, 0.45);
}

.support-chat-widget {
  position: fixed;
  left: 20px;
  bottom: 24px;
  z-index: 9998;
}

.support-chat-toggle {
  border: 0;
  border-radius: 999px;
  background: linear-gradient(135deg, #05489c, #0c63d4);
  color: #fff;
  box-shadow: 0 14px 30px rgba(5, 72, 156, 0.28);
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 12px 18px 12px 12px;
  font-size: 14px;
  font-weight: 700;
}

.support-chat-toggle__icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  line-height: 1;
}

.support-chat-panel {
  width: min(360px, calc(100vw - 32px));
  margin-top: 12px;
  background: #fff;
  border: 1px solid rgba(190, 201, 229, 0.7);
  border-radius: 20px;
  box-shadow: 0 24px 60px rgba(19, 39, 80, 0.22);
  overflow: hidden;
}

.support-chat-panel__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 18px 14px;
  background: linear-gradient(135deg, #f4f8ff, #ffffff);
  border-bottom: 1px solid rgba(190, 201, 229, 0.45);
}

.support-chat-panel__eyebrow {
  margin: 0 0 4px;
  color: #8c96b0;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.support-chat-panel__title {
  margin: 0;
  color: #1d2433;
  font-size: 20px;
  font-weight: 700;
}

.support-chat-panel__close {
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 50%;
  background: rgba(5, 72, 156, 0.08);
  color: #05489c;
  font-size: 16px;
  font-weight: 700;
  line-height: 1;
}

.support-chat-panel__body {
  padding: 16px;
}

.support-chat-panel__copy {
  margin: 0 0 12px;
  color: #6b7280;
  font-size: 13px;
  line-height: 1.5;
}

.support-chat-questions {
  max-height: 420px;
  overflow-y: auto;
  padding-right: 4px;
}

.support-chat-question {
  width: 100%;
  text-align: left;
  margin-bottom: 10px;
  padding: 12px 14px;
  border: 1px solid rgba(190, 201, 229, 0.7);
  border-radius: 14px;
  background: #fff;
  color: #1d2433;
  font-size: 13px;
  font-weight: 600;
  line-height: 1.45;
  transition: all 0.2s ease;
}

.support-chat-question:hover {
  border-color: #05489c;
  background: rgba(5, 72, 156, 0.04);
}

.support-chat-answer__question {
  margin: 0 0 10px;
  color: #05489c;
  font-size: 13px;
  font-weight: 700;
}

.support-chat-answer__bubble {
  padding: 14px 15px;
  border-radius: 16px;
  background: #f4f7fd;
  color: #30384a;
  font-size: 13px;
  line-height: 1.6;
  border: 1px solid rgba(190, 201, 229, 0.55);
}

.support-chat-answer__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 14px;
}

.support-chat-secondary,
.support-chat-primary {
  min-height: 42px;
  padding: 10px 14px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.support-chat-secondary {
  border: 1px solid rgba(5, 72, 156, 0.18);
  background: #fff;
  color: #05489c;
}

.support-chat-primary {
  border: 0;
  background: #05489c;
  color: #fff !important;
}

@media (max-width: 991.98px) {
  .leaderboard-card {
    margin-bottom: 20px;
  }

  .support-chat-widget {
    left: 14px;
    bottom: 18px;
  }

  .support-chat-toggle {
    padding-right: 16px;
  }
}
